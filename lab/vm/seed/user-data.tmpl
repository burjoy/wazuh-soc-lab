#cloud-config
hostname: soc-victim
manage_etc_hosts: true
preserve_hostname: false

users:
  - default
  - name: analyst
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBKEY__

ssh_pwauth: false
disable_root: true

package_update: true
packages:
  - nginx
  - auditd
  - suricata
  - jq
  - curl
  - python3

runcmd:
  - systemctl enable --now ssh
  - systemctl enable --now nginx
  - systemctl enable --now auditd
  - systemctl enable --now suricata
  - timedatectl set-timezone UTC
  - echo "soc-victim provisioned" > /var/log/cloud-init-lab.log
