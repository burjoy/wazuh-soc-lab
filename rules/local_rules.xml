<!--
  Local rules for the SOC L1 lab.

  INC-001
    100120  FIM: authorized_keys added or modified (SSH persistence)

  INC-002
    100121  usermod adds an account to a privileged group
    100122  interactive SSH login by a service account (svc-*)
    100131  service-account login after the brute-force correlation (40112)
    100123  gpasswd adds an account to a privileged group
    100124  adduser adds an account to a privileged group
    100125  useradd creates an account directly in a privileged group
    100126  usermod -a -G adds an account to a privileged group (shifted argv)

  INC-003
    100127  HTTP request to a .php file carrying a cmd= parameter
    100128  PHP file added under the webroot

  INC-004
    100129  cron file added or modified under /etc/cron.d
    100130  systemd unit or enable-link changed under /etc/systemd/system

  Privileged groups in this lab: sudo (Debian), wheel (RHEL family), admin.
  If your estate uses different groups, change the alternation in 100121/100123/
  100124/100125/100126 or move the list into a CDB lookup.
-->

<group name="local,syscheck,">

  <rule id="100120" level="12">
    <if_sid>550,554</if_sid>
    <match>authorized_keys</match>
    <description>FIM: SSH authorized_keys added or modified (possible persistence)</description>
    <mitre>
      <id>T1098.004</id>
      <id>T1078</id>
    </mitre>
    <group>syscheck,persistence,</group>
  </rule>

</group>

<group name="local,audit,">

  <!-- The primary path: usermod -aG sudo user, or usermod -G sudo user. -->
  <rule id="100121" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.exe">/usr/sbin/usermod</field>
    <field name="audit.execve.a2" type="pcre2">^(sudo|wheel|admin)$</field>
    <description>Privilege assignment: user $(audit.execve.a3) added to privileged group $(audit.execve.a2) via usermod</description>
    <mitre>
      <id>T1098</id>
      <id>T1548.003</id>
    </mitre>
    <group>audit_command,privilege_escalation,</group>
  </rule>

  <!-- usermod -a -G sudo user; a3 is the group. This is the form Debian
       adduser uses internally, and it shifts the argument index compared with
       -aG. -->
  <rule id="100126" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.exe">/usr/sbin/usermod</field>
    <field name="audit.execve.a1">-a</field>
    <field name="audit.execve.a2">-G</field>
    <field name="audit.execve.a3" type="pcre2">^(sudo|wheel|admin)$</field>
    <description>Privilege assignment: user $(audit.execve.a4) added to privileged group $(audit.execve.a3) via usermod -a -G</description>
    <mitre>
      <id>T1098</id>
      <id>T1548.003</id>
    </mitre>
    <group>audit_command,privilege_escalation,</group>
  </rule>

  <!-- gpasswd -a user sudo; a3 is the group. -->
  <rule id="100123" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.exe">/usr/bin/gpasswd</field>
    <field name="audit.execve.a1">-a</field>
    <field name="audit.execve.a3" type="pcre2">^(sudo|wheel|admin)$</field>
    <description>Privilege assignment: user $(audit.execve.a2) added to privileged group $(audit.execve.a3) via gpasswd</description>
    <mitre>
      <id>T1098</id>
      <id>T1548.003</id>
    </mitre>
    <group>audit_command,privilege_escalation,</group>
  </rule>

  <!-- Debian adduser user sudo; a2 is the user, a3 is the group. -->
  <rule id="100124" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.exe">/usr/bin/perl</field>
    <field name="audit.execve.a1">/usr/sbin/adduser</field>
    <field name="audit.execve.a3" type="pcre2">^(sudo|wheel|admin)$</field>
    <description>Privilege assignment: user $(audit.execve.a2) added to privileged group $(audit.execve.a3) via adduser</description>
    <mitre>
      <id>T1098</id>
      <id>T1548.003</id>
    </mitre>
    <group>audit_command,privilege_escalation,</group>
  </rule>

  <!-- useradd -G sudo user; a1 is -G and a2 is the group in the canonical
       ordering. Options before -G shift the index, which is why the FIM +
       group-baseline check remains necessary. -->
  <rule id="100125" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.exe">/usr/sbin/useradd</field>
    <field name="audit.execve.a1">-G</field>
    <field name="audit.execve.a2" type="pcre2">^(sudo|wheel|admin)$</field>
    <description>Privilege assignment: new account $(audit.execve.a3) created in privileged group $(audit.execve.a2)</description>
    <mitre>
      <id>T1136.001</id>
      <id>T1098</id>
    </mitre>
    <group>audit_command,privilege_escalation,</group>
  </rule>

</group>

<group name="local,syslog,sshd,">

  <rule id="100122" level="10">
    <if_sid>5715</if_sid>
    <match>for svc-</match>
    <description>SSH: interactive login by a service account</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100131" level="12">
    <if_sid>40112</if_sid>
    <match>for svc-</match>
    <description>SSH: service-account login after brute-force correlation</description>
    <mitre>
      <id>T1078</id>
      <id>T1110</id>
    </mitre>
    <group>authentication_success,brute_force,</group>
  </rule>

</group>

<group name="local,web,">

  <rule id="100127" level="12">
    <if_sid>31100</if_sid>
    <match>.php?cmd=</match>
    <description>Web: command parameter in a PHP request (possible web shell)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1059.004</id>
    </mitre>
    <group>web,attack,</group>
  </rule>

</group>

<group name="local,syscheck,">

  <rule id="100128" level="12">
    <if_sid>550,554</if_sid>
    <match>.php</match>
    <description>FIM: PHP file added under a monitored path (possible web shell)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>syscheck,web,persistence,</group>
  </rule>

</group>


<group name="local,syscheck,">

  <rule id="100129" level="12">
    <if_sid>550,554</if_sid>
    <match>/etc/cron.d/</match>
    <description>FIM: cron file added or modified (possible persistence)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>syscheck,persistence,</group>
  </rule>

  <rule id="100130" level="10">
    <if_sid>550,554</if_sid>
    <match>/etc/systemd/system/</match>
    <description>FIM: systemd unit or enable-link changed (possible persistence)</description>
    <mitre>
      <id>T1543.002</id>
    </mitre>
    <group>syscheck,persistence,</group>
  </rule>

</group>
